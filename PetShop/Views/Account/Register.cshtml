@model PetShop.Models.UserRegisterViewModel
@{
    ViewData["Title"] = "Qeydiyyat - Yeni Hesab";
}

<section class="py-5" style="background-color: #FAF7F2; min-height: 75vh;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3" style="width: 64px; height: 64px;">
                            <iconify-icon icon="solar:user-plus-bold" class="fs-1"></iconify-icon>
                        </div>
                        <h2 class="fw-bold mb-1">Yeni Hesab Yaradın</h2>
                        <p class="text-muted small">PetShop ailəsinə qoşulun, sifarişlərinizi asanlıqla idarə edin.</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-3 mb-4" role="alert"></div>

                    <form asp-action="Register" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-dark">Ad və Soyad <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <iconify-icon icon="solar:user-bold" class="fs-5"></iconify-icon>
                                </span>
                                <input asp-for="FullName" type="text" class="form-control bg-light border-start-0 py-2" placeholder="Məsələn: Əli Məmmədov" required autocomplete="name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark">E-poçt Ünvanı <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <iconify-icon icon="solar:letter-bold" class="fs-5"></iconify-icon>
                                </span>
                                <input asp-for="Email" type="email" class="form-control bg-light border-start-0 py-2" placeholder="adınız@numune.az" required autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold text-dark">Əlaqə Nömrəsi <span class="text-muted small fw-normal">(İstəyə bağlı)</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <iconify-icon icon="solar:phone-bold" class="fs-5"></iconify-icon>
                                </span>
                                <input asp-for="Phone" type="tel" class="form-control bg-light border-start-0 py-2" placeholder="+994 50 123 45 67" autocomplete="tel" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold text-dark">Şifrə <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <iconify-icon icon="solar:lock-password-bold" class="fs-5"></iconify-icon>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control bg-light border-start-0 py-2" placeholder="Min. 6 simvol" required autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark">Şifrə Təkrarı <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <iconify-icon icon="solar:lock-password-bold" class="fs-5"></iconify-icon>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-start-0 py-2" placeholder="Təkrar daxil edin" required autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6 fw-semibold rounded-pill shadow-sm">
                            Qeydiyyatdan Keç
                        </button>
                    </form>

                    <hr class="my-4 text-muted">

                    <div class="text-center">
                        <p class="mb-0 text-muted small">
                            Artıq hesabınız var?
                            <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">
                                Daxil olun
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
