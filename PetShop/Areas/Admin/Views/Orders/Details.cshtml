@model PetShop.DataContext.Entites.Order
@{ ViewData["Title"] = "Order Details"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <h1 class="h3 mb-1">Order #@Model.Id</h1>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Orders</a>
        </div>

        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="panel p-4 mb-4">
                    <h5 class="mb-3">Order Items</h5>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.OrderItems) {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.ProductName</div>
                                        <div class="text-muted small">ID: @item.ProductId</div>
                                    </td>
                                    <td>$@item.UnitPrice</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold">$@item.TotalPrice</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end text-muted">Subtotal:</td>
                                <td class="fw-bold">$@Model.Subtotal</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end text-muted">Discount (@Model.CouponCode):</td>
                                <td class="text-danger">-$@Model.DiscountAmount</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fs-5">Total:</td>
                                <td class="fw-bold fs-5 text-primary">$@Model.TotalAmount</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="panel p-4 mb-4">
                    <h5 class="mb-3">Customer Details</h5>
                    <p class="mb-1"><i class="bi bi-person text-muted me-2"></i> @Model.CustomerName</p>
                    <p class="mb-1"><i class="bi bi-envelope text-muted me-2"></i> @Model.Email</p>
                    <p class="mb-1"><i class="bi bi-telephone text-muted me-2"></i> @Model.Phone</p>
                    
                    <h5 class="mb-2 mt-4">Shipping Address</h5>
                    <p class="text-muted">@Model.ShippingAddress</p>

                    @if(!string.IsNullOrEmpty(Model.OrderNotes)) {
                        <h5 class="mb-2 mt-4">Order Notes</h5>
                        <p class="text-muted">"@Model.OrderNotes"</p>
                    }
                </div>

                <div class="panel p-4 bg-light">
                    <h5 class="mb-3">Update Status</h5>
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label text-muted small">Current Status: @Model.OrderStatus</label>
                            <select name="newStatus" class="form-select">
                                <!option value="Pending" @(Model.OrderStatus == "Pending" ? "selected" : "")>Pending</!option>
                                <!option value="Processing" @(Model.OrderStatus == "Processing" ? "selected" : "")>Processing</!option>
                                <!option value="Shipped" @(Model.OrderStatus == "Shipped" ? "selected" : "")>Shipped</!option>
                                <!option value="Delivered" @(Model.OrderStatus == "Delivered" ? "selected" : "")>Delivered</!option>
                                <!option value="Cancelled" @(Model.OrderStatus == "Cancelled" ? "selected" : "")>Cancelled</!option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Update Status</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
