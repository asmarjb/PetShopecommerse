@model PetShop.DataContext.Entites.Product
@{ ViewData["Title"] = "Edit Product"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <h1 class="h3 mb-0">Edit Product</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>

        <section class="panel mt-4" style="max-width: 800px;">
            <div class="panel-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Product Name *</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Sku" class="form-label">SKU</label>
                            <input asp-for="Sku" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Price *</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountPrice" class="form-label">Discount Price</label>
                            <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="StockQuantity" class="form-label">Stock Quantity *</label>
                            <input asp-for="StockQuantity" class="form-control" type="number" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ProductCategoryId" class="form-label">Category *</label>
                            <select asp-for="ProductCategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="BrandId" class="form-label">Brand</label>
                            <select asp-for="BrandId" class="form-select" asp-items="ViewBag.Brands">
                                <option value="">-- No Brand --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox">
                        <label class="form-check-label" asp-for="IsActive">Is Active?</label>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Existing Images</label>
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                @foreach(var img in Model.Images)
                                {
                                    <div class="position-relative border p-1 rounded" id="img-container-@img.Id">
                                        <img src="@img.ImageUrl" style="width: 80px; height: 80px; object-fit: cover;" />
                                        <div id="badge-container-@img.Id">
                                            @if(img.IsMain) { <span class="badge bg-primary position-absolute top-0 start-0">Main</span> }
                                        </div>
                                        <div class="position-absolute bottom-0 start-50 translate-middle-x pb-1 w-100 text-center" style="background: rgba(255,255,255,0.7);">
                                            @if(!img.IsMain) {
                                                <button type="button" onclick="setMainImage(@img.Id)" class="btn btn-xs btn-outline-primary" style="font-size: 0.65rem; padding: 1px 4px;">Make Main</button>
                                            }
                                        </div>
                                        <button type="button" onclick="deleteImage(@img.Id)" class="btn btn-sm btn-danger position-absolute top-0 end-0" style="transform: translate(50%, -50%); border-radius: 50%; padding: 2px 6px;" title="Delete">&times;</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">No images uploaded.</p>
                        }

                        <label class="form-label mt-2">Add New Images</label>
                        <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        function deleteImage(imageId) {
            if(confirm("Are you sure you want to delete this image?")) {
                fetch('@Url.Action("DeleteImage", "Products", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: 'imageId=' + imageId
                })
                .then(response => {
                    if(response.ok) {
                        document.getElementById('img-container-' + imageId).remove();
                    } else {
                        alert("Failed to delete image.");
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("An error occurred.");
                });
            }
        }

        function setMainImage(imageId) {
            fetch('@Url.Action("SetMainImage", "Products", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: 'imageId=' + imageId
            })
            .then(response => {
                if(response.ok) {
                    location.reload(); // simple reload to reflect the badge UI changes
                } else {
                    alert("Failed to set main image.");
                }
            })
            .catch(err => {
                console.error(err);
                alert("An error occurred.");
            });
        }
    </script>
}
