@model PetShop.DataContext.Entites.Brand
@{ ViewData["Title"] = "Edit Brand"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <h1 class="h3 mb-4">Edit Brand</h1>
        <form asp-action="Edit" enctype="multipart/form-data" class="panel p-4" style="max-width:600px;">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Brand Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Logo</label>
                @if (!string.IsNullOrEmpty(Model.LogoUrl)) {
                    <img src="@Model.LogoUrl" style="width: 80px; display:block; margin-bottom: 10px;" />
                }
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </form>
    </div>
</main>
