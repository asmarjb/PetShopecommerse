@model IEnumerable<PetShop.DataContext.Entites.Product>

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-table" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Data Management</p>
                    <h1 class="h3 mb-1">Data Tables</h1>
                    <p class="text-muted mb-0">Tabular representation of all products in the database.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a href="/Admin/Dashboard/ExportProducts" class="btn btn-primary btn-sm"><i class="bi bi-download"></i> Export CSV</a>
            </div>
        </div>

        <section class="panel mt-4">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">Products Inventory</h2>
                    <p class="text-muted mb-0">Complete list of items available in the pet shop.</p>
                </div>
                <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search products...">
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Category</th>
                            <th scope="col">Brand</th>
                            <th scope="col">Price</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="text-muted fw-medium">#@item.Id</span></td>
                                    <td>
                                        <div class="fw-semibold">@item.Name</div>
                                        @if (!string.IsNullOrEmpty(item.Sku))
                                        {
                                            <div class="text-muted small">SKU: @item.Sku</div>
                                        }
                                    </td>
                                    <td>@(item.ProductCategory?.Name ?? "Uncategorized")</td>
                                    <td>@(item.Brand?.Name ?? "-")</td>
                                    <td>
                                        @if (item.DiscountPrice.HasValue)
                                        {
                                            <span class="text-danger fw-semibold">$@item.DiscountPrice</span>
                                            <span class="text-muted text-decoration-line-through small ms-1">$@item.Price</span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">$@item.Price</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.StockQuantity > 10)
                                        {
                                            <span class="badge text-bg-light border text-dark">@item.StockQuantity in stock</span>
                                        }
                                        else if (item.StockQuantity > 0)
                                        {
                                            <span class="badge text-bg-warning">Low: @item.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">Out of stock</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                    No products found in the database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="panel-footer border-top p-3 d-flex align-items-center justify-content-between bg-light rounded-bottom">
                <span class="text-muted small">Showing @Model?.Count() items</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link" href="#">Prev</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item disabled"><a class="page-link" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </section>
    </div>
</main>
