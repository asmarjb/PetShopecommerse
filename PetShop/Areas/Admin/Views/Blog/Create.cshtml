@model PetShop.DataContext.Entites.BlogPost
@{ ViewData["Title"] = "Create Post"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <h1 class="h3 mb-4">Create Blog Post</h1>
        <form asp-action="Create" enctype="multipart/form-data" class="panel p-4" style="max-width:800px;">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Slug</label>
                <input asp-for="Slug" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Author" class="form-label">Author</label>
                <input asp-for="Author" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="form-label">Summary</label>
                <textarea asp-for="Summary" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Content" class="form-label">Content</label>
                <textarea asp-for="Content" class="form-control" rows="8"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Main Image</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
            <div class="mb-3 form-check form-switch">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox">
                <label class="form-check-label" asp-for="IsPublished">Publish immediately</label>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </form>
    </div>
</main>
