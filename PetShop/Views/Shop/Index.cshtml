@model PetShop.Models.ShopViewModel
@{
    var selectedAnimal = Model.SelectedAnimalTypeId.HasValue
        ? Model.AnimalTypes.FirstOrDefault(a => a.Id == Model.SelectedAnimalTypeId.Value)
        : null;

    var animalDisplayName = selectedAnimal?.Name?.ToLower() switch
    {
        var s when s != null && (s.Contains("it") || s.Contains("dog")) => "Dog",
        var s when s != null && (s.Contains("pi") || s.Contains("cat")) => "Cat",
        var s when s != null && (s.Contains("qu") || s.Contains("bird")) => "Bird",
        var s when s != null && (s.Contains("bal") || s.Contains("fish")) => "Fish",
        _ => selectedAnimal?.Name
    };

    var animalIcon = animalDisplayName switch
    {
        "Dog" => "ph:dog",
        "Cat" => "ph:cat",
        "Bird" => "ph:bird",
        "Fish" => "ph:fish",
        _ => "ph:paw-print"
    };

    ViewData["Title"] = selectedAnimal != null ? $"{animalDisplayName} Products - Pet Shop" : "Shop - All Products";
}

<div class="shopify-grid">
    <div class="container py-5 my-5">

        @if (selectedAnimal != null)
        {
            <div class="card border-0 rounded-4 shadow-sm mb-4 mb-lg-5 bg-light">
                <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; min-width: 56px;">
                            <iconify-icon icon="@animalIcon" class="text-primary fs-2"></iconify-icon>
                        </div>
                        <div>
                            <h2 class="h4 fw-bold mb-0">@animalDisplayName Products</h2>
                            <span class="text-muted small">@Model.TotalItems items found</span>
                        </div>
                    </div>
                    <div>
                        <a href="/Shop" class="btn btn-outline-dark btn-sm rounded-1 px-3 py-2 text-uppercase">
                            All Products
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="row flex-md-row-reverse gx-lg-5 gx-md-4 gy-0 mb-5">

            <!-- MAIN PRODUCT LISTING -->
            <main class="col-md-9">

                <!-- TOP BAR: Showing count & Sorting -->
                <div class="filter-shop d-md-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div class="showing-product mb-2 mb-md-0">
                        @if (Model.TotalItems > 0)
                        {
                            <p class="m-0 text-muted">
                                Showing <strong>@Model.StartItem–@Model.EndItem</strong> of <strong>@Model.TotalItems</strong> results
                            </p>
                        }
                        else
                        {
                            <p class="m-0 text-muted">0 results found</p>
                        }
                    </div>

                    <div class="sort-by d-flex align-items-center gap-2">
                        <label class="text-muted fs-6 mb-0 text-nowrap">Sort by:</label>
                        <select class="filter-categories border rounded-2 px-3 py-2 m-0 bg-transparent" id="sortBySelect" onchange="applySorting(this.value)">
                            <option value="default" selected="@(string.IsNullOrEmpty(Model.SortBy) || Model.SortBy == "default")">Default (Newest)</option>
                            <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A - Z)</option>
                            <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z - A)</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price (Low-High)</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price (High-Low)</option>
                            <option value="discount" selected="@(Model.SortBy == "discount")">On Sale (Special Offers)</option>
                        </select>
                    </div>
                </div>

                <!-- ACTIVE FILTERS BADGES -->
                @if (Model.HasActiveFilters)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-3 bg-light rounded-3">
                        <span class="text-muted small fw-bold">Active Filters:</span>

                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <span class="badge bg-white text-dark border p-2">
                                Search: "@Model.SearchTerm"
                                <a href="@Url.Action("Index", "Shop", new {
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.SelectedCategoryId.HasValue)
                        {
                            var catName = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId.Value)?.Name ?? "Category";
                            <span class="badge bg-white text-dark border p-2">
                                Category: @catName
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.SelectedAnimalTypeId.HasValue)
                        {
                            <span class="badge bg-white text-dark border p-2">
                                Pet: @animalDisplayName
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.SelectedBrandId.HasValue)
                        {
                            var brandName = Model.Brands.FirstOrDefault(b => b.Id == Model.SelectedBrandId.Value)?.Name ?? "Brand";
                            <span class="badge bg-white text-dark border p-2">
                                Brand: @brandName
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                        {
                            <span class="badge bg-white text-dark border p-2">
                                Price: @(Model.MinPrice?.ToString("0.##") ?? "0") &#8380; - @(Model.MaxPrice?.ToString("0.##") ?? "∞") &#8380;
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.OnlyInStock)
                        {
                            <span class="badge bg-white text-dark border p-2">
                                In Stock Only
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        @if (Model.OnlyDiscounted)
                        {
                            <span class="badge bg-white text-dark border p-2">
                                On Sale Only
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = (bool?)null
                                })" class="text-danger ms-1 text-decoration-none">&times;</a>
                            </span>
                        }

                        <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-outline-danger ms-auto rounded-pill px-3">
                            Clear Filters
                        </a>
                    </div>
                }

                <!-- PRODUCT GRID -->
                @if (!Model.Products.Any())
                {
                    <div class="text-center py-5 my-5">
                        <iconify-icon icon="tabler:search-off" class="text-muted" style="font-size: 5rem;"></iconify-icon>
                        <h3 class="mt-3">No products found</h3>
                        <p class="text-muted">Try adjusting or clearing your filters.</p>
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-1 px-4 py-2 mt-2">
                            View All Products
                        </a>
                    </div>
                }
                else
                {
                    <div class="product-grid row">
                        @foreach (var product in Model.Products)
                        {
                            var imageFileName = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? product.Images.FirstOrDefault()?.ImageUrl;
                            var mainImage = string.IsNullOrEmpty(imageFileName) ? "/images/no-image.png" : (imageFileName.StartsWith("/") ? imageFileName : $"/images/{imageFileName}");
                            var isOutOfStock = product.StockQuantity <= 0;
                            var isNew = product.CreatedAt >= DateTime.UtcNow.AddDays(-14);
                            var hasDiscount = product.DiscountPrice.HasValue && product.DiscountPrice.Value < product.Price;

                            <div class="col-md-4 my-4">
                                <div class="card position-relative h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column justify-content-between">

                                    <!-- BADGES -->
                                    @if (isOutOfStock)
                                    {
                                        <div class="z-1 position-absolute rounded-3 m-3 px-3 py-1 bg-secondary text-white fw-medium small">
                                            Sold Out
                                        </div>
                                    }
                                    else if (hasDiscount)
                                    {
                                        var discountPercent = Math.Round((1 - (product.DiscountPrice!.Value / product.Price)) * 100);
                                        <div class="z-1 position-absolute rounded-3 m-3 px-3 py-1 bg-danger text-white fw-medium small">
                                            -@discountPercent%
                                        </div>
                                    }
                                    else if (isNew)
                                    {
                                        <div class="z-1 position-absolute rounded-3 m-3 px-3 py-1 border border-dark-subtle bg-white text-dark fw-medium small">
                                            New
                                        </div>
                                    }

                                    <!-- PRODUCT IMAGE -->
                                    <a href="/product/@product.Id" class="product-image-container">
                                        <img src="@mainImage" class="img-fluid" alt="@product.Name"
                                             onerror="this.onerror=null;this.src='/images/no-image.png';">
                                    </a>

                                    <!-- CARD BODY -->
                                    <div class="card-body p-4 d-flex flex-column justify-content-between flex-grow-1">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge bg-light text-secondary border small">
                                                    @(product.ProductCategory?.Name ?? "General")
                                                </span>
                                                @if (product.Brand != null)
                                                {
                                                    <span class="text-muted small">@product.Brand.Name</span>
                                                }
                                            </div>

                                            <a href="/product/@product.Id" class="text-decoration-none">
                                                <h4 class="card-title m-0 pt-2 text-dark fw-semibold text-truncate" title="@product.Name">
                                                    @product.Name
                                                </h4>
                                            </a>
                                        </div>

                                        <div class="card-text mt-3">
                                            <div class="rating secondary-font mb-2">
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    <iconify-icon icon="clarity:star-solid" class="text-primary"></iconify-icon>
                                                }
                                                <span class="ms-1 small text-muted">5.0</span>
                                            </div>

                                            <!-- PRICE -->
                                            <div class="price-wrapper mb-3">
                                                @if (hasDiscount)
                                                {
                                                    <div class="d-flex align-items-baseline gap-2">
                                                        <h3 class="secondary-font text-primary m-0">@product.DiscountPrice!.Value.ToString("0.00") &#8380;</h3>
                                                        <span class="text-decoration-line-through text-muted small">@product.Price.ToString("0.00") &#8380;</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <h3 class="secondary-font text-primary m-0">@product.Price.ToString("0.00") &#8380;</h3>
                                                }
                                            </div>

                                            <!-- BUTTONS: Add to Cart & Wishlist -->
                                            <div class="d-flex flex-wrap gap-2">
                                                @if (isOutOfStock)
                                                {
                                                    <button class="btn btn-secondary flex-grow-1 py-2 text-uppercase fs-6 rounded-1 disabled" disabled>
                                                        Sold Out
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a href="#" class="btn-cart flex-grow-1 px-3 py-2 text-center text-uppercase rounded-1 text-decoration-none"
                                                       onclick="AddToBasket(@product.Id); return false;">
                                                        <span class="fw-semibold small">Add to Cart</span>
                                                    </a>
                                                }
                                                @{
                                                    bool isWishlisted = Model.WishlistProductIds.Contains(product.Id);
                                                }
                                                <a href="#" class="btn-wishlist px-3 py-2 rounded-1 d-flex align-items-center justify-content-center text-decoration-none @(isWishlisted ? "wishlisted" : "")"
                                                   data-product-id="@product.Id"
                                                   onclick="toggleWishlist(this, @product.Id); return false;"
                                                   title="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")">
                                                    <iconify-icon icon="fluent:heart-28-filled" class="fs-5"></iconify-icon>
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- PAGINATION -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="navigation paging-navigation text-center mt-5" role="navigation">
                            <div class="pagination loop-pagination d-flex justify-content-center align-items-center gap-2">

                                <!-- PREVIOUS PAGE -->
                                @if (Model.HasPreviousPage)
                                {
                                    <a href="@Url.Action("Index", "Shop", new {
                                        searchTerm = Model.SearchTerm,
                                        categoryId = Model.SelectedCategoryId,
                                        animalTypeId = Model.SelectedAnimalTypeId,
                                        brandId = Model.SelectedBrandId,
                                        minPrice = Model.MinPrice,
                                        maxPrice = Model.MaxPrice,
                                        sortBy = Model.SortBy,
                                        inStock = Model.OnlyInStock ? true : (bool?)null,
                                        onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null,
                                        page = Model.CurrentPage - 1
                                    })" class="pagination-arrow d-flex align-items-center justify-content-center p-2 rounded-circle border text-dark text-decoration-none" style="width: 44px; height: 44px;" title="Previous">
                                        <iconify-icon icon="ic:baseline-keyboard-arrow-left" class="fs-4"></iconify-icon>
                                    </a>
                                }

                                <!-- PAGE NUMBERS -->
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    if (p == Model.CurrentPage)
                                    {
                                        <span aria-current="page" class="page-numbers current fs-5 px-3 py-2 bg-primary text-white rounded-2 fw-bold">@p</span>
                                    }
                                    else if (p <= 2 || p >= Model.TotalPages - 1 || (p >= Model.CurrentPage - 1 && p <= Model.CurrentPage + 1))
                                    {
                                        <a class="page-numbers fs-5 px-3 py-2 text-dark text-decoration-none border rounded-2" href="@Url.Action("Index", "Shop", new {
                                            searchTerm = Model.SearchTerm,
                                            categoryId = Model.SelectedCategoryId,
                                            animalTypeId = Model.SelectedAnimalTypeId,
                                            brandId = Model.SelectedBrandId,
                                            minPrice = Model.MinPrice,
                                            maxPrice = Model.MaxPrice,
                                            sortBy = Model.SortBy,
                                            inStock = Model.OnlyInStock ? true : (bool?)null,
                                            onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null,
                                            page = p
                                        })">@p</a>
                                    }
                                    else if (p == 3 && Model.CurrentPage > 3)
                                    {
                                        <span class="page-numbers fs-5 px-2 text-muted">...</span>
                                    }
                                    else if (p == Model.TotalPages - 2 && Model.CurrentPage < Model.TotalPages - 2)
                                    {
                                        <span class="page-numbers fs-5 px-2 text-muted">...</span>
                                    }
                                }

                                <!-- NEXT PAGE -->
                                @if (Model.HasNextPage)
                                {
                                    <a href="@Url.Action("Index", "Shop", new {
                                        searchTerm = Model.SearchTerm,
                                        categoryId = Model.SelectedCategoryId,
                                        animalTypeId = Model.SelectedAnimalTypeId,
                                        brandId = Model.SelectedBrandId,
                                        minPrice = Model.MinPrice,
                                        maxPrice = Model.MaxPrice,
                                        sortBy = Model.SortBy,
                                        inStock = Model.OnlyInStock ? true : (bool?)null,
                                        onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null,
                                        page = Model.CurrentPage + 1
                                    })" class="pagination-arrow d-flex align-items-center justify-content-center p-2 rounded-circle border text-dark text-decoration-none" style="width: 44px; height: 44px;" title="Next">
                                        <iconify-icon icon="ic:baseline-keyboard-arrow-right" class="fs-4"></iconify-icon>
                                    </a>
                                }

                            </div>
                        </nav>
                    }
                }

            </main>

            <!-- SIDEBAR WITH FILTERS -->
            <aside class="col-md-3 mt-5 mt-md-0">
                <div class="sidebar">

                    <!-- 1. SEARCH BAR -->
                    <div class="widget-menu">
                        <div class="widget-search-bar">
                            <div class="search-bar border rounded-2 border-dark-subtle pe-2">
                                <form id="search-form" class="text-center d-flex align-items-center" asp-controller="Shop" asp-action="Index" method="get">
                                    @if (Model.SelectedCategoryId.HasValue)
                                    {
                                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId.Value" />
                                    }
                                    @if (Model.SelectedAnimalTypeId.HasValue)
                                    {
                                        <input type="hidden" name="animalTypeId" value="@Model.SelectedAnimalTypeId.Value" />
                                    }
                                    @if (Model.SelectedBrandId.HasValue)
                                    {
                                        <input type="hidden" name="brandId" value="@Model.SelectedBrandId.Value" />
                                    }
                                    @if (Model.MinPrice.HasValue)
                                    {
                                        <input type="hidden" name="minPrice" value="@Model.MinPrice.Value" />
                                    }
                                    @if (Model.MaxPrice.HasValue)
                                    {
                                        <input type="hidden" name="maxPrice" value="@Model.MaxPrice.Value" />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.SortBy))
                                    {
                                        <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                    }
                                    @if (Model.OnlyInStock)
                                    {
                                        <input type="hidden" name="inStock" value="true" />
                                    }
                                    @if (Model.OnlyDiscounted)
                                    {
                                        <input type="hidden" name="onlyDiscounted" value="true" />
                                    }

                                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-0 bg-transparent py-2" placeholder="Search for products..." />
                                    <button type="submit" class="border-0 bg-transparent p-0 text-muted" title="Search">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
                                            <path fill="currentColor"
                                                  d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- 2. QUICK TOGGLE FILTERS (In Stock & Discount) -->
                    <div class="widget-quick-filters pt-4">
                        <h4 class="widget-title mb-3">Status</h4>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="inStockCheck" @(Model.OnlyInStock ? "checked" : "")
                                   onchange="toggleFilter('inStock', this.checked)">
                            <label class="form-check-label user-select-none" for="inStockCheck">
                                In Stock Only
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="onlyDiscountCheck" @(Model.OnlyDiscounted ? "checked" : "")
                                   onchange="toggleFilter('onlyDiscounted', this.checked)">
                            <label class="form-check-label user-select-none" for="onlyDiscountCheck">
                                On Sale Only
                            </label>
                        </div>
                    </div>

                    <!-- 3. CATEGORIES -->
                    <div class="widget-product-categories pt-4">
                        <h4 class="widget-title mb-3">Categories</h4>
                        <ul class="product-categories sidebar-list list-unstyled">
                            <li class="cat-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(!Model.SelectedCategoryId.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    All Categories
                                </a>
                            </li>
                            @foreach (var cat in Model.Categories)
                            {
                                var isSelected = Model.SelectedCategoryId == cat.Id;
                                <li class="cat-item mb-2">
                                    <a href="@Url.Action("Index", "Shop", new {
                                        searchTerm = Model.SearchTerm,
                                        categoryId = cat.Id,
                                        animalTypeId = Model.SelectedAnimalTypeId,
                                        brandId = Model.SelectedBrandId,
                                        minPrice = Model.MinPrice,
                                        maxPrice = Model.MaxPrice,
                                        sortBy = Model.SortBy,
                                        inStock = Model.OnlyInStock ? true : (bool?)null,
                                        onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                    })" class="nav-link @(isSelected ? "fw-bold text-primary" : "text-muted")">
                                        @cat.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- 4. ANIMAL TYPES (Tags/Pets) -->
                    <div class="widget-product-tags pt-3">
                        <h4 class="widget-title mb-3">Pet Types</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(!Model.SelectedAnimalTypeId.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    All Pets
                                </a>
                            </li>
                            @foreach (var animal in Model.AnimalTypes)
                            {
                                var isSelected = Model.SelectedAnimalTypeId == animal.Id;
                                var aName = animal.Name?.ToLower() switch
                                {
                                    var s when s.Contains("it") || s.Contains("dog") => "Dog",
                                    var s when s.Contains("pi") || s.Contains("cat") => "Cat",
                                    var s when s.Contains("qu") || s.Contains("bird") => "Bird",
                                    var s when s.Contains("bal") || s.Contains("fish") => "Fish",
                                    _ => animal.Name
                                };
                                <li class="tags-item mb-2">
                                    <a href="@Url.Action("Index", "Shop", new {
                                        searchTerm = Model.SearchTerm,
                                        categoryId = Model.SelectedCategoryId,
                                        animalTypeId = animal.Id,
                                        brandId = Model.SelectedBrandId,
                                        minPrice = Model.MinPrice,
                                        maxPrice = Model.MaxPrice,
                                        sortBy = Model.SortBy,
                                        inStock = Model.OnlyInStock ? true : (bool?)null,
                                        onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                    })" class="nav-link @(isSelected ? "fw-bold text-primary" : "text-muted")">
                                        @aName
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- 5. BRANDS -->
                    <div class="widget-product-brands pt-3">
                        <h4 class="widget-title mb-3">Brands</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(!Model.SelectedBrandId.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    All Brands
                                </a>
                            </li>
                            @foreach (var brand in Model.Brands)
                            {
                                var isSelected = Model.SelectedBrandId == brand.Id;
                                <li class="tags-item mb-2">
                                    <a href="@Url.Action("Index", "Shop", new {
                                        searchTerm = Model.SearchTerm,
                                        categoryId = Model.SelectedCategoryId,
                                        animalTypeId = Model.SelectedAnimalTypeId,
                                        brandId = brand.Id,
                                        minPrice = Model.MinPrice,
                                        maxPrice = Model.MaxPrice,
                                        sortBy = Model.SortBy,
                                        inStock = Model.OnlyInStock ? true : (bool?)null,
                                        onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                    })" class="nav-link @(isSelected ? "fw-bold text-primary" : "text-muted")">
                                        @brand.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- 6. FILTER BY PRICE -->
                    <div class="widget-price-filter pt-3">
                        <h4 class="widget-title mb-3">Filter By Price</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(!Model.MinPrice.HasValue && !Model.MaxPrice.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    All Prices
                                </a>
                            </li>
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    maxPrice = 10,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(Model.MaxPrice == 10 && !Model.MinPrice.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    Less than 10 &#8380;
                                </a>
                            </li>
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = 10,
                                    maxPrice = 20,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(Model.MinPrice == 10 && Model.MaxPrice == 20 ? "fw-bold text-primary" : "text-muted")">
                                    10 &#8380; - 20 &#8380;
                                </a>
                            </li>
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = 20,
                                    maxPrice = 30,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(Model.MinPrice == 20 && Model.MaxPrice == 30 ? "fw-bold text-primary" : "text-muted")">
                                    20 &#8380; - 30 &#8380;
                                </a>
                            </li>
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = 30,
                                    maxPrice = 50,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(Model.MinPrice == 30 && Model.MaxPrice == 50 ? "fw-bold text-primary" : "text-muted")">
                                    30 &#8380; - 50 &#8380;
                                </a>
                            </li>
                            <li class="tags-item mb-2">
                                <a href="@Url.Action("Index", "Shop", new {
                                    searchTerm = Model.SearchTerm,
                                    categoryId = Model.SelectedCategoryId,
                                    animalTypeId = Model.SelectedAnimalTypeId,
                                    brandId = Model.SelectedBrandId,
                                    minPrice = 50,
                                    sortBy = Model.SortBy,
                                    inStock = Model.OnlyInStock ? true : (bool?)null,
                                    onlyDiscounted = Model.OnlyDiscounted ? true : (bool?)null
                                })" class="nav-link @(Model.MinPrice == 50 && !Model.MaxPrice.HasValue ? "fw-bold text-primary" : "text-muted")">
                                    More than 50 &#8380;
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </aside>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applySorting(sortBy) {
            const url = new URL(window.location.href);
            if (sortBy && sortBy !== 'default') {
                url.searchParams.set('sortBy', sortBy);
            } else {
                url.searchParams.delete('sortBy');
            }
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }

        function toggleFilter(filterName, isChecked) {
            const url = new URL(window.location.href);
            if (isChecked) {
                url.searchParams.set(filterName, 'true');
            } else {
                url.searchParams.delete(filterName);
            }
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }
    </script>
}
