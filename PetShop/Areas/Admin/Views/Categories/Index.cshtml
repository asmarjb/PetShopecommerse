@model IEnumerable<PetShop.DataContext.Entites.ProductCategory>
@{ ViewData["Title"] = "Categories"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                <div>
                    <h1 class="h3 mb-1">Categories</h1>
                    <p class="text-muted mb-0">Manage product categories.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Add Category</a>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <section class="panel mt-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Parent Category</th>
                            <th>Slug</th>
                            <th>Icon</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                                        var imgSrc = item.ImageUrl.StartsWith("/") ? item.ImageUrl : $"/images/{item.ImageUrl}";
                                        <img src="@imgSrc" style="width: 45px; height: 45px; object-fit: cover;" class="rounded border" />
                                    } else {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted border" style="width: 45px; height: 45px;"><i class="bi bi-image"></i></div>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>
                                    @if (item.ParentCategory != null)
                                    {
                                        <span class="badge bg-secondary">@item.ParentCategory.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Ana kateqoriya</span>
                                    }
                                </td>
                                <td><code>@item.Slug</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IconClass))
                                    {
                                        <span><i class="@item.IconClass me-1"></i> @item.IconClass</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Redaktə et"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kateqoriyanı silmək istədiyinizdən əminsiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
