<script>

    const CartItems= document.getElementById("CartItems");
    async function AddToBasket(productId) {
        let response = await fetch(`/Home/AddBasket/${productId}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            }
        });

        if (response.ok) {
            const CartTotalPrice= document.getElementById("CartTotalPrice");
            document.getElementById("CartItemCount").innerText = data.items.reduce((total, item) => total + (item.count || item.quantity || 1), 0);
            let data = await response.json();
            console.log(data)
            CartTotalPrice.innerHTML = `$${data.totalPrice.toFixed(2)}`;
            CartItems.innerHTML = '';
            for (let item of data.items) {
                    CartItems.innerHTML += `                                                    <li class="product-box-contain">
                                                            <div class="drop-cart">
                                                                <a href="product-left-thumbnail.html" class="drop-image">
                                                                    <img src="/assets/images/vegetable/product/${item.productImagePath}"
                                                                    class="blur-up lazyload" alt="">
                                                                </a>

                                                                <div class="drop-contain">
                                                                    <a href="product-left-thumbnail.html">
                                                                        <h5>${item.productName}</h5>
                                                                    </a>
                                                                    <h6><span> ${item.tota} x</span> ${item.price}</h6>
                                                                    <button class="close-button close_button">
                                                                        <i class="fa-solid fa-xmark"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </li>
    `;
            }
        }
        else {
            console.error("Failed to add item to basket");
        }
    }

</script>
