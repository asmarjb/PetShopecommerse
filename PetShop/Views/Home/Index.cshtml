<section id="categories" class="py-4">
    <div class="container">
        <div class="row justify-content-center my-4 g-3 g-md-4">
            @foreach (var animal in animalTypes)
            {
                var icon = animal.Name?.ToLower() switch
                {
                    var s when s.Contains("it") || s.Contains("dog") => "ph:dog",
                    var s when s.Contains("pi") || s.Contains("cat") => "ph:cat",
                    var s when s.Contains("qu") || s.Contains("bird") => "ph:bird",
                    var s when s.Contains("bal") || s.Contains("fish") => "ph:fish",
                    _ => "ph:paw-print"
                };
                var displayName = animal.Name?.ToLower() switch
                {
                    var s when s.Contains("it") || s.Contains("dog") => "Dog",
                    var s when s.Contains("pi") || s.Contains("cat") => "Cat",
                    var s when s.Contains("qu") || s.Contains("bird") => "Bird",
                    var s when s.Contains("bal") || s.Contains("fish") => "Fish",
                    _ => animal.Name
                };

                <div class="col-6 col-sm-3 col-md-3 text-center">
                    <a href="/Shop?animalTypeId=@animal.Id" class="categories-item">
                        <iconify-icon class="category-icon" icon="@icon"></iconify-icon>
                        <h5 class="mt-3">@displayName</h5>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section id="clothing" class="my-5 overflow-hidden">
    <div class="container pb-5">
        <div class="section-header d-md-flex justify-content-between align-items-center mb-3">
            <h2 class="display-3 fw-normal">Pet Clothing</h2>
            <div>
                <a href="/products/cloth" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-1">
                    shop now
                    <svg width="24" height="24" viewBox="0 0 24 24" class="mb-1"><use xlink:href="#arrow-right"></use></svg>
                </a>
            </div>
        </div>
        <div class="products-carousel swiper">
            <div class="swiper-wrapper">
                @foreach (var product in products.Where(p => p.ProductCategory.Slug.StartsWith("cloth")))
                {
                    var imageFileName = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? product.Images.FirstOrDefault()?.ImageUrl;
                    var mainImage = string.IsNullOrEmpty(imageFileName) ? "/images/no-image.png" : (imageFileName.StartsWith("/") ? imageFileName : $"/images/{imageFileName}");

                    <div class="swiper-slide">
                        @if (product.CreatedAt >= DateTime.UtcNow.AddDays(-14))
                        {
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">New</div>
                        }
                        else if (product.DiscountPrice.HasValue)
                        {
                            var discountPercent = Math.Round((1 - (product.DiscountPrice.Value / product.Price)) * 100);
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">-@discountPercent%</div>
                        }

                        <div class="card position-relative h-100 d-flex flex-column">
                            <a href="/product/@product.Id" class="product-image-container">
                                <img src="@mainImage" class="img-fluid" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';">
                            </a>
                            <div class="card-body p-0 d-flex flex-column flex-grow-1">
                                <a href="/product/@product.Id">
                                    <h3 class="card-title pt-4 m-0">@product.Name</h3>
                                </a>
                                <div class="card-text mt-auto">
                                    <span class="rating secondary-font">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <iconify-icon icon="clarity:star-solid" class="text-primary"></iconify-icon>
                                        }
                                        5.0
                                    </span>
                                    <h3 class="secondary-font text-primary">@(product.DiscountPrice ?? product.Price) &#8380;</h3>
                                    <div class="d-flex flex-wrap mt-3">
                                        @if (product.StockQuantity <= 0)
                                        {
                                            <button class="btn btn-secondary me-3 px-4 pt-3 pb-3 disabled rounded-1" disabled>
                                                <h5 class="text-uppercase m-0">Sold Out</h5>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn-cart me-3 px-4 pt-3 pb-3" onclick="AddToBasket(@product.Id); return false;">
                                                <h5 class="text-uppercase m-0">Add to Cart</h5>
                                            </a>
                                        }
                                        <a href="#" class="btn-wishlist px-4 pt-3 @(model.WishlistProductIds.Contains(product.Id) ? "wishlisted" : "")"
                                           data-product-id="@product.Id"
                                           onclick="toggleWishlist(this, @product.Id); return false;"
                                           title="@(model.WishlistProductIds.Contains(product.Id) ? "Remove from wishlist" : "Add to wishlist")">
                                            <iconify-icon icon="fluent:heart-28-filled" class="fs-5"></iconify-icon>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section id="foodies" class="my-5">
    <div class="container my-5 py-5">

        <div class="section-header d-md-flex justify-content-between align-items-center">
            <h2 class="display-3 fw-normal">Pet Foodies</h2>
            <div class="mb-4 mb-md-0">
                <p class="m-0">
                    <button class="filter-button me-4  active" data-filter="*">ALL</button>
                    @foreach (var animal in animalTypes)
                    {
                        var animalFilter = $".animal-{animal.Id}, .{animal.Name.ToLowerInvariant()}, .{animal.Name.ToLower()}";
                        var aButtonName = animal.Name?.ToLower() switch
                        {
                            var s when s.Contains("it") || s.Contains("dog") => "DOG",
                            var s when s.Contains("pi") || s.Contains("cat") => "CAT",
                            var s when s.Contains("qu") || s.Contains("bird") => "BIRD",
                            var s when s.Contains("bal") || s.Contains("fish") => "FISH",
                            _ => animal.Name?.ToUpper()
                        };
                        <button class="filter-button me-4" data-filter="@animalFilter">@aButtonName</button>
                    }
                </p>
            </div>
            <div>
                <a href="/products/food" class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-1">
                    shop now
                    <svg width="24" height="24" viewBox="0 0 24 24" class="mb-1"><use xlink:href="#arrow-right"></use></svg>
                </a>
            </div>
        </div>

        <div class="isotope-container row">

            @foreach (var product in products.Where(p => p.ProductCategory != null && (p.ProductCategory.Slug.StartsWith("food") || p.ProductCategory.Slug.Contains("yem") || p.ProductCategory.Name.ToLower().Contains("yem"))))
            {
				var animalClassList = product.ProductAnimalTypes.Select(a => $"animal-{a.AnimalTypeId} {a.AnimalType.Name.ToLowerInvariant()} {a.AnimalType.Name.ToLower()}").ToList();
                if (!animalClassList.Any())
                {
                    if (product.ProductCategory?.Name?.ToLower().Contains("balıq") == true || product.ProductCategory?.Slug?.Contains("fish") == true || product.Name.ToLower().Contains("balıq"))
                    {
                        animalClassList.Add("animal-4 balıq baliq");
                    }
                }
                var animalClasses = string.Join(" ", animalClassList);
                var imageFileName = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? product.Images.FirstOrDefault()?.ImageUrl;
                var mainImage = string.IsNullOrEmpty(imageFileName) ? "/images/no-image.png" : (imageFileName.StartsWith("/") ? imageFileName : $"/images/{imageFileName}");

                <div class="item @animalClasses col-md-4 col-lg-3 my-4">
                    <div class="card position-relative h-100 d-flex flex-column">
                        @if (product.StockQuantity == 0)
                        {
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">Sold</div>
                        }
                        else if (product.DiscountPrice.HasValue)
                        {
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">Sale</div>
                        }

                        <a href="/product/@product.Id" class="product-image-container">
                            <img src="@mainImage" class="img-fluid" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';">
                        </a>
                        <div class="card-body p-0 d-flex flex-column flex-grow-1">
                            <a href="/product/@product.Id">
                                <h3 class="card-title pt-4 m-0">@product.Name</h3>
                            </a>
                            <div class="card-text mt-auto">
                                <span class="rating secondary-font">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <iconify-icon icon="clarity:star-solid" class="text-primary"></iconify-icon>
                                    }
                                    5.0
                                </span>
                                <h3 class="secondary-font text-primary">@(product.DiscountPrice ?? product.Price) &#8380;</h3>
                                    <div class="d-flex flex-wrap mt-3">
                                        @if (product.StockQuantity <= 0)
                                        {
                                            <button class="btn btn-secondary me-3 px-4 pt-3 pb-3 disabled rounded-1" disabled>
                                                <h5 class="text-uppercase m-0">Sold Out</h5>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn-cart me-3 px-4 pt-3 pb-3" onclick="AddToBasket(@product.Id); return false;">
                                                <h5 class="text-uppercase m-0">Add to Cart</h5>
                                            </a>
                                        }
                                        <a href="#" class="btn-wishlist px-4 pt-3 @(model.WishlistProductIds.Contains(product.Id) ? "wishlisted" : "")"
                                           data-product-id="@product.Id"
                                           onclick="toggleWishlist(this, @product.Id); return false;"
                                           title="@(model.WishlistProductIds.Contains(product.Id) ? "Remove from wishlist" : "Add to wishlist")">
                                            <iconify-icon icon="fluent:heart-28-filled" class="fs-5"></iconify-icon>
                                        </a>
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
            }


        </div>


    </div>
</section>

