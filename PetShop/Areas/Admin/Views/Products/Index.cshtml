@model IEnumerable<PetShop.DataContext.Entites.Product>
@{ ViewData["Title"] = "Products"; }

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <div>
                    <h1 class="h3 mb-1">Products</h1>
                    <p class="text-muted mb-0">Manage store products.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Add Product</a>
            </div>
        </div>

        <section class="panel mt-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Main Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            var mainImage = item.Images.FirstOrDefault(i => i.IsMain) ?? item.Images.FirstOrDefault();
                            <tr>
                                <td>
                                    @if (mainImage != null) {
                                        var imgSrc = mainImage.ImageUrl.StartsWith("/") ? mainImage.ImageUrl : $"/images/{mainImage.ImageUrl}";
                                        <img src="@imgSrc" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                                    } else {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px;"><i class="bi bi-image"></i></div>
                                    }
                                </td>
                                <td class="fw-semibold">
                                    @item.Name
                                    <div class="text-muted small">SKU: @item.Sku</div>
                                </td>
                                <td>@(item.ProductCategory?.Name)</td>
                                <td>
                                    @if(item.DiscountPrice.HasValue){
                                        <span class="text-danger fw-bold">$@item.DiscountPrice</span>
                                        <del class="text-muted small">$@item.Price</del>
                                    } else {
                                        <span>$@item.Price</span>
                                    }
                                </td>
                                <td>@item.StockQuantity</td>
                                <td>
                                    @if (item.IsActive) { <span class="badge text-bg-success">Active</span> } 
                                    else { <span class="badge text-bg-secondary">Inactive</span> }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
