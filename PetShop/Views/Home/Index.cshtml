        </div>

        <div class=" swiper bestselling-swiper">
            <div class="swiper-wrapper">
                @foreach (var product in products.OrderByDescending(p => p.DiscountPrice.HasValue).ThenByDescending(p => p.CreatedAt).Take(8))
                {
                    var imageFileName = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? product.Images.FirstOrDefault()?.ImageUrl;
                    var mainImage = string.IsNullOrEmpty(imageFileName) ? "/images/no-image.png" : (imageFileName.StartsWith("/") ? imageFileName : $"/images/{imageFileName}");

                    <div class="swiper-slide">
                        @if (product.StockQuantity <= 0)
                        {
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle bg-light text-muted">Sold</div>
                        }
                        else if (product.CreatedAt >= DateTime.UtcNow.AddDays(-14))
                        {
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">New</div>
                        }
                        else if (product.DiscountPrice.HasValue)
                        {
                            var discountPercent = Math.Round((1 - (product.DiscountPrice.Value / product.Price)) * 100);
                            <div class="z-1 position-absolute rounded-3 m-3 px-3 border border-dark-subtle">-@discountPercent%</div>
                        }

                        <div class="card position-relative h-100 d-flex flex-column">
                            <a href="/product/@product.Id" class="product-image-container">
                                <img src="@mainImage" class="img-fluid" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';">
                            </a>
                            <div class="card-body p-0 d-flex flex-column flex-grow-1">
                                <a href="/product/@product.Id">
                                    <h3 class="card-title pt-4 m-0">@product.Name</h3>
                                </a>
                                <div class="card-text mt-auto">
                                    <span class="rating secondary-font">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <iconify-icon icon="clarity:star-solid" class="text-primary"></iconify-icon>
                                        }
                                        5.0
                                    </span>
                                    <h3 class="secondary-font text-primary">@(product.DiscountPrice ?? product.Price) &#8380;</h3>
                                    <div class="d-flex flex-wrap mt-3">
                                        @if (product.StockQuantity <= 0)
                                        {
                                            <button class="btn btn-secondary me-3 px-4 pt-3 pb-3 disabled rounded-1" disabled>
                                                <h5 class="text-uppercase m-0">Sold Out</h5>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn-cart me-3 px-4 pt-3 pb-3" onclick="AddToBasket(@product.Id); return false;">
                                                <h5 class="text-uppercase m-0">Add to Cart</h5>
                                            </a>
                                        }
                                        <a href="#" class="btn-wishlist px-4 pt-3 @(model.WishlistProductIds.Contains(product.Id) ? "wishlisted" : "")"
                                           data-product-id="@product.Id"
                                           onclick="toggleWishlist(this, @product.Id); return false;"
                                           title="@(model.WishlistProductIds.Contains(product.Id) ? "Remove from wishlist" : "Add to wishlist")">
                                            <iconify-icon icon="fluent:heart-28-filled" class="fs-5"></iconify-icon>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!-- / category-carousel -->


    </div>
</section>

