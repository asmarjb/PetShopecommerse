@model PetShop.Areas.Admin.Models.DashboardViewModel

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Overview</p>
                    <h1 class="h3 mb-1">Dashboard</h1>
                    <p class="text-muted mb-0">Monitor products, categories, brands, and users from one clean workspace.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a href="/Admin/Dashboard/ExportProducts" class="btn btn-outline-secondary btn-sm" title="Download full products CSV">
                    <i class="bi bi-download" aria-hidden="true"></i> Export
                </a>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#createReportModal">
                    <i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Create Report
                </button>
            </div>
        </div>

        <section class="row g-3 mt-1" aria-label="Dashboard metrics">
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-primary" style="cursor: pointer;" onclick="window.location.href='/Admin/Products'">
                    <div class="metric-top">
                        <span class="metric-label">Products</span>
                        <span class="metric-icon"><i class="bi bi-box" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">@Model.TotalProducts</div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-success" style="cursor: pointer;" onclick="window.location.href='/Admin/Categories'">
                    <div class="metric-top">
                        <span class="metric-label">Categories</span>
                        <span class="metric-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">@Model.TotalCategories</div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-warning" style="cursor: pointer;" onclick="window.location.href='/Admin/Brands'">
                    <div class="metric-top">
                        <span class="metric-label">Brands</span>
                        <span class="metric-icon"><i class="bi bi-award" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">@Model.TotalBrands</div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-danger" style="cursor: pointer;" onclick="window.location.href='/Admin/Blog'">
                    <div class="metric-top">
                        <span class="metric-label">Blog Posts</span>
                        <span class="metric-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">@Model.TotalBlogPosts</div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-primary" style="cursor: pointer;" onclick="window.location.href='/Admin/Orders'">
                    <div class="metric-top">
                        <span class="metric-label">Total Orders</span>
                        <span class="metric-icon"><i class="bi bi-cart-check" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">@Model.TotalOrders</div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <article class="metric-card metric-success" style="cursor: pointer;" onclick="window.location.href='/Admin/Orders'">
                    <div class="metric-top">
                        <span class="metric-label">Revenue</span>
                        <span class="metric-icon"><i class="bi bi-currency-dollar" aria-hidden="true"></i></span>
                    </div>
                    <div class="metric-value">$@Model.TotalRevenue.ToString("N2")</div>
                </article>
            </div>
        </section>

        <section class="row g-3 mt-1">
            <div class="col-12 col-xl-8">
                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>Sales Performance</span></h2>
                            <p class="text-muted mb-0">Monthly revenue compared with operational targets.</p>
                        </div>
                        <a class="btn btn-light btn-sm" href="/Admin/Orders">View Details</a>
                    </div>

                    <div class="chart-bars" aria-label="Sales performance chart">
                        <div class="chart-column bar-42"><span></span><small>Jan</small></div>
                        <div class="chart-column bar-58"><span></span><small>Feb</small></div>
                        <div class="chart-column bar-51"><span></span><small>Mar</small></div>
                        <div class="chart-column bar-72"><span></span><small>Apr</small></div>
                        <div class="chart-column bar-66"><span></span><small>May</small></div>
                        <div class="chart-column bar-83"><span></span><small>Jun</small></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="panel h-100">
                    <div class="panel-header">
                        <div>
                            <h2 class="h5 mb-1 section-title"><i class="bi bi-activity" aria-hidden="true"></i><span>Recent Orders</span></h2>
                            <p class="text-muted mb-0">Latest customer purchases.</p>
                        </div>
                    </div>

                    <div class="activity-list">
                        @if(Model.RecentOrders.Any())
                        {
                            foreach(var order in Model.RecentOrders)
                            {
                                <div class="activity-item">
                                    <span class="activity-dot @(order.OrderStatus == "Pending" ? "bg-warning" : "bg-success")"></span>
                                    <div>
                                        <p class="mb-1 fw-semibold">@order.CustomerName - $@order.TotalAmount</p>
                                        <p class="text-muted small mb-0">@order.OrderStatus • @order.CreatedAt.ToString("MMM dd, HH:mm")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">No recent orders found.</p>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="panel mt-3">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-people" aria-hidden="true"></i><span>Recent Admins</span></h2>
                    <p class="text-muted mb-0">Latest registered admin accounts.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Joined</th><th scope="col" class="text-end">Action</th></tr></thead>
                    <tbody>
                        @if (Model.RecentUsers != null && Model.RecentUsers.Any())
                        {
                            foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-img avatar-sm bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <p class="fw-semibold mb-0">@user.FullName</p>
                                                <p class="text-muted small mb-0">@user.Email</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>Admin</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end"><button class="btn btn-light btn-sm">View</button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No admins found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>

<!-- Create Report Modal -->
<div class="modal fade" id="createReportModal" tabindex="-1" aria-labelledby="createReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="get" action="/Admin/Dashboard/Report">
                <div class="modal-header">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="createReportModalLabel">
                        <i class="bi bi-file-earmark-bar-graph text-primary"></i> Create Summary Report
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Generate an analytical sales & inventory report. Choose a date range to filter orders and revenue, or select a quick preset.
                    </p>

                    <!-- Quick presets -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted d-block">Quick Presets</label>
                        <div class="btn-group btn-group-sm w-100" role="group" aria-label="Date presets">
                            <button type="button" class="btn btn-outline-secondary" onclick="setDateRange(7)">Last 7 Days</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setDateRange(30)">Last 30 Days</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setThisMonth()">This Month</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setAllTime()">All Time</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label for="reportFromDate" class="form-label small fw-semibold">From Date</label>
                            <input type="date" class="form-control" id="reportFromDate" name="from" 
                                   value="@DateTime.UtcNow.Date.AddDays(-30).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-6">
                            <label for="reportToDate" class="form-label small fw-semibold">To Date</label>
                            <input type="date" class="form-control" id="reportToDate" name="to" 
                                   value="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")">
                        </div>
                    </div>

                    <div class="mt-3 p-2 bg-light rounded small text-muted">
                        <i class="bi bi-info-circle me-1 text-primary"></i> 
                        Inventory data (stock, category breakdowns) will reflect current real-time levels.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-file-earmark-check"></i> Generate Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function setDateRange(days) {
        const today = new Date();
        const from = new Date();
        from.setDate(today.getDate() - days);
        document.getElementById('reportToDate').value = today.toISOString().split('T')[0];
        document.getElementById('reportFromDate').value = from.toISOString().split('T')[0];
    }

    function setThisMonth() {
        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        document.getElementById('reportToDate').value = today.toISOString().split('T')[0];
        document.getElementById('reportFromDate').value = firstDay.toISOString().split('T')[0];
    }

    function setAllTime() {
        const today = new Date();
        document.getElementById('reportToDate').value = today.toISOString().split('T')[0];
        document.getElementById('reportFromDate').value = "2020-01-01";
    }
</script>
}
