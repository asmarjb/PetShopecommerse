@{
    Layout = null;
    ViewData["Title"] = "Giriş Qadağandır";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Admin Panel</title>
    <link rel="stylesheet" href="~/admin/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/admin/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/admin/assets/css/style.css">
    <style>
        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f6f9;
        }
        .auth-card {
            width: 100%;
            max-width: 480px;
            padding: 3rem 2.5rem;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            background: #fff;
            text-align: center;
        }
        .error-icon {
            width: 80px;
            height: 80px;
            line-height: 80px;
            border-radius: 50%;
            background: #fee2e2;
            color: #ef4444;
            font-size: 2.5rem;
            margin: 0 auto 1.5rem auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="error-icon">
            <i class="bi bi-shield-slash-fill"></i>
        </div>

        <h2 class="fw-bold text-dark mb-2">Giriş Məhdudlaşdırılıb!</h2>
        <p class="text-danger fw-medium mb-3">Bu hissəyə yalnız idarəçi (admin) hesabları daxil ola bilər.</p>
        <p class="text-muted small mb-4">
            Siz hazırda adi istifadəçi hesabı ilə daxil olmusunuz və ya idarəçi səlahiyyətiniz yoxdur.
            Admin panelinə keçid üçün admin məlumatlarınız ilə daxil olmalısınız.
        </p>

        <div class="d-grid gap-2">
            <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-dark py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Admin Girişi
            </a>
            <a href="/" class="btn btn-outline-secondary py-2 fw-semibold">
                <i class="bi bi-house-door me-1"></i> Əsas Səhifəyə Qayıt
            </a>
        </div>
    </div>
</div>

<script src="~/admin/assets/js/bootstrap.bundle.min.js"></script>
</body>
</html>
