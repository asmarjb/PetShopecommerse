@model PetShopEcommerse.Models.WishlistViewModel
@{
    ViewData["Title"] = "&#304;st&#601;k Siyah&#305;s&#305; (Wishlist)";
}

<section id="Wishlist" class="py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-4 fw-normal">İstək Siyahısı</h1>
            </div>
        </div>
        <!-- Bo&#351; ist&#601;k siyah&#305;s&#305; bildiri&#351;i -->
        <div id="WishlistEmptyContainer" class="@(Model == null || Model.IsEmpty ? "" : "d-none") text-center py-5 my-5">
            <iconify-icon icon="fluent:heart-broken-24-regular" class="text-muted" style="font-size: 5rem;"></iconify-icon>
            <h3 class="mt-3">&#304;st&#601;k siyah&#305;n&#305;z bo&#351;dur</h3>
            <p class="text-muted">B&#601;y&#601;ndiyiniz m&#601;hsullar&#305; &#252;r&#601;k ikonuna klikl&#601;y&#601;r&#601;k buraya &#601;lav&#601; ed&#601; bil&#601;rsiniz.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-1 px-4 py-2 mt-2">
                M&#601;hsullara Bax
            </a>
        </div>

        <!-- M&#601;hsullar c&#601;dv&#601;li -->
        <div id="WishlistTableContainer" class="@(Model == null || Model.IsEmpty ? "d-none" : "") table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="card-title text-uppercase">MƏHSUL</th>
                        <th scope="col" class="card-title text-uppercase">QİYMƏT</th>
                        <th scope="col" class="card-title text-uppercase text-end">ƏMƏLİYYAT</th>
                    </tr>
                </thead>
                <tbody id="WishlistTableBody">
                    @if (Model != null && !Model.IsEmpty)
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr id="wishlist-row-@item.WishlistItemId">
                                <td class="py-4">
                                    <div class="cart-info d-flex align-items-center">
                                        <div style="width: 80px; height: 80px; flex-shrink: 0;" class="me-3">
                                            <a href="/product/@item.ProductId">
                                                <img src="@item.ProductImagePath" alt="@item.ProductName" class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                                                     onerror="this.onerror=null;this.src='/images/no-image.png';">
                                            </a>
                                        </div>
                                        <div>
                                            <h5 class="card-title mb-1">
                                                <a href="/product/@item.ProductId" class="text-decoration-none text-dark fw-medium">
                                                    @item.ProductName
                                                </a>
                                            </h5>
                                            @if (!string.IsNullOrEmpty(item.CategoryName))
                                            {
                                                <span class="badge bg-light text-muted border small me-1">@item.CategoryName</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.VariantLabel))
                                            {
                                                <span class="badge bg-light text-dark border small">@item.VariantLabel</span>
                                            }
                                            @* Stock warning inline — only shown when < 5 *@
                                            @if (item.IsOutOfStock)
                                            {
                                                <div class="mt-1">
                                                    <span class="small fw-semibold text-danger">
                                                        <iconify-icon icon="mdi:close-circle" class="me-1"></iconify-icon>Tükənib
                                                    </span>
                                                </div>
                                            }
                                            else if (item.StockQuantity < 5)
                                            {
                                                <div class="mt-1">
                                                    <span class="small fw-semibold text-warning">
                                                        <iconify-icon icon="mdi:alert" class="me-1"></iconify-icon>Yalnız @item.StockQuantity ədəd qaldı!
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4">
                                    <div class="total-price">
                                        @if (item.DiscountPrice.HasValue && item.DiscountPrice.Value < item.Price)
                                        {
                                            <span class="secondary-font fw-medium text-primary fs-5">@item.DiscountPrice.Value.ToString("0.00") &#8380;</span>
                                            <span class="text-decoration-line-through text-muted small ms-1">@item.Price.ToString("0.00") &#8380;</span>
                                        }
                                        else
                                        {
                                            <span class="secondary-font fw-medium text-primary fs-5">@item.Price.ToString("0.00") &#8380;</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-4 text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-3" id="action-wrapper-@item.ProductId">
                                        @if (item.IsOutOfStock)
                                        {
                                            <button class="btn btn-secondary px-4 py-2 text-uppercase fs-6 rounded-1 text-nowrap disabled" disabled>
                                                T&#252;k&#601;nib
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn btn-dark px-4 py-2 text-uppercase fs-6 rounded-1 text-nowrap text-decoration-none add-to-cart-btn"
                                               data-product-id="@item.ProductId"
                                               onclick="AddToBasket(@item.ProductId, @(item.ProductVariantId.HasValue ? item.ProductVariantId.Value.ToString() : "null")); return false;">
                                                S&#601;b&#601;t&#601; at
                                            </a>
                                        }
                                        <button type="button" class="btn btn-link text-danger p-0 ms-2" title="&#304;st&#601;k siyah&#305;s&#305;ndan sil"
                                                onclick="removeFromWishlist(@item.WishlistItemId, @item.ProductId)">
                                            <iconify-icon icon="tabler:trash" class="fs-4"></iconify-icon>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>