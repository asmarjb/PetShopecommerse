@model BasketViewModel

<div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasCart" aria-labelledby="My Cart" style="width: 420px;">
    <div class="offcanvas-header border-bottom py-3">
        <div class="d-flex align-items-center gap-2">
            <iconify-icon icon="solar:cart-large-4-bold" class="fs-4 text-primary"></iconify-icon>
            <h5 class="offcanvas-title fw-bold text-dark mb-0">Your Cart</h5>
            <span class="badge bg-dark rounded-pill" id="CartItemCount">@Model.TotalItemCount</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column p-3">
        <!-- Empty cart message -->
        <div class="text-center my-auto py-5 @(Model.IsEmpty ? "" : "d-none")" id="CartEmptyMessage">
            <iconify-icon icon="mdi:cart-off" class="text-muted" style="font-size: 4rem;"></iconify-icon>
            <h5 class="mt-3 text-dark fw-bold">Your cart is empty</h5>
            <p class="text-muted small">Add your favorite items to the cart.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark rounded-1 px-4 mt-2">Go to Shop</a>
        </div>

        <!-- Product list -->
        <ul class="list-group list-group-flush mb-3 flex-grow-1 @(Model.IsEmpty ? "d-none" : "")" id="CartItems">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item py-3 px-0 border-bottom" data-cart-item-id="@item.CartItemId">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@item.ProductImagePath" alt="@item.ProductName"
                             style="width: 55px; height: 55px; object-fit: cover;"
                             class="rounded border flex-shrink-0"
                             onerror="this.onerror=null;this.src='/images/no-image.png';">
                        <div class="flex-grow-1 min-w-0">
                            <a href="/product/@item.ProductId" class="text-decoration-none text-dark">
                                <h6 class="my-0 text-truncate" title="@item.ProductName">@item.ProductName</h6>
                            </a>
                            @if (!string.IsNullOrEmpty(item.VariantLabel))
                            {
                                <small class="text-muted d-block text-truncate">@item.VariantLabel</small>
                            }
                            <div class="small fw-medium text-dark mt-1">@item.UnitPrice.ToString("0.00")₼</div>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <div class="fw-bold text-dark mb-1">@item.TotalPrice.ToString("0.00")₼</div>
                            <button type="button" class="btn btn-link text-danger p-0 border-0 fs-6 text-decoration-none"
                                    onclick="removeFromCart(@item.CartItemId)" title="Remove">
                                <iconify-icon icon="mdi:trash-can-outline"></iconify-icon>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top border-light">
                        <span class="small text-dark fw-medium">Qty:</span>
                        <div class="qty-stepper d-inline-flex align-items-center justify-content-center border rounded-2 bg-white shadow-sm" style="height: 30px;">
                            <button type="button" class="btn btn-link text-dark p-0 d-flex align-items-center justify-content-center border-0"
                                    style="width: 26px; height: 100%; text-decoration: none;"
                                    onclick="updateQuantity(@item.CartItemId, @(item.Quantity - 1))"
                                    title="Decrease">
                                <iconify-icon icon="mdi:minus" style="font-size: 0.8rem;"></iconify-icon>
                            </button>
                            <input type="text" class="form-control border-0 text-center p-0 fw-bold text-dark"
                                   style="width: 32px; height: 100%; box-shadow: none; background: transparent; font-size: 0.85rem;"
                                   readonly value="@item.Quantity">
                            <button type="button" class="btn btn-link text-dark p-0 d-flex align-items-center justify-content-center border-0"
                                    style="width: 26px; height: 100%; text-decoration: none;"
                                    onclick="updateQuantity(@item.CartItemId, @(item.Quantity + 1))"
                                    title="Increase">
                                <iconify-icon icon="mdi:plus" style="font-size: 0.8rem;"></iconify-icon>
                            </button>
                        </div>
                    </div>
                </li>
            }
        </ul>

        <!-- Coupon section -->
        <div class="mb-3 flex-shrink-0 @(Model.IsEmpty ? "d-none" : "")" id="CartCouponSection">
            <div id="CartCouponContainer">
                @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                {
                    <div class="d-flex align-items-center justify-content-between p-2 rounded border" style="background-color: #e8f5e9; border-color: #a5d6a7 !important;" id="CartCouponAppliedBox">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-white fw-bold px-2 py-1" style="background-color: #2e7d32; font-size: 0.8rem;" id="CartAppliedCouponBadge">@Model.AppliedCouponCode</span>
                            <span class="fw-bold small" style="color: #1b5e20;" id="CartAppliedCouponText">
                                @(Model.DiscountPercent.HasValue ? $"{Model.DiscountPercent.Value:0}% off" : $"{Model.DiscountAmount:0.00} ₼ off")
                            </span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 fw-semibold" onclick="removeCoupon()" title="Remove coupon">
                            <iconify-icon icon="mdi:close" class="align-middle"></iconify-icon> Remove
                        </button>
                    </div>
                }
                else
                {
                    <div id="CartCouponInputBox">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control text-uppercase ps-3 text-dark fw-medium"
                                   placeholder="Enter coupon code"
                                   id="CartCouponCodeInput"
                                   style="font-size: 0.85rem; letter-spacing: 0.5px;">
                            <button class="btn btn-dark px-3 text-nowrap"
                                    type="button"
                                    onclick="applyCoupon('CartCouponCodeInput')"
                                    style="font-size: 0.8rem; font-weight: 500;">
                                Apply
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div id="CartCouponMessage" class="small mt-1 d-none"></div>
        </div>

        <!-- Cart summary and action buttons -->
        <div class="cart-bottom-actions mt-auto flex-shrink-0 @(Model.IsEmpty ? "d-none" : "")" id="CartFooterSection">
            <div class="card border rounded-3 shadow-sm mb-3">
                <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center"
                     role="button"
                     id="CartTotalToggleBtn"
                     data-bs-toggle="collapse"
                     data-bs-target="#CartBreakdownDetails"
                     aria-expanded="false"
                     aria-controls="CartBreakdownDetails"
                     style="cursor: pointer; user-select: none;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-6 fw-bold text-dark mb-0">Total:</span>
                        <span class="badge bg-white text-secondary border px-2 py-1 small d-inline-flex align-items-center gap-1 shadow-sm">
                            <span>Details</span>
                            <iconify-icon icon="mdi:chevron-down" id="CartCollapseChevron" class="fs-6" style="transition: transform 0.25s ease;"></iconify-icon>
                        </span>
                    </div>
                    <strong class="fs-5 fw-bold text-dark mb-0" id="CartFinalPrice">@Model.FinalTotal.ToString("0.00")₼</strong>
                </div>

                <div class="collapse" id="CartBreakdownDetails">
                    <div class="card-body p-3 bg-white border-top">
                        <!-- Subtotal -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-dark small fw-semibold" style="color: #111111 !important;">Subtotal:</span>
                            <span class="text-dark fw-bold small" id="CartSubtotalPrice" style="color: #111111 !important;">@Model.TotalPrice.ToString("0.00")₼</span>
                        </div>

                        <!-- Shipping -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-dark small fw-semibold" style="color: #111111 !important;">Shipping:</span>
                            <span class="small fw-bold @(Model.IsFreeShipping ? "" : "text-dark")" style="@(Model.IsFreeShipping ? "color: #2e7d32;" : "color: #111111 !important;")" id="CartShippingDisplay">
                                @(Model.IsFreeShipping ? "Free 🎉" : $"{Model.ShippingFee:0.00} ₼")
                            </span>
                        </div>

                        <!-- Free shipping hint -->
                        <div id="CartShippingHintContainer">
                            @if (!Model.IsFreeShipping && !Model.IsEmpty)
                            {
                                <div class="small mb-2" style="font-size: 0.78rem; color: #6c757d;">
                                    Add <strong class="text-primary">@Model.AmountNeededForFreeShipping.ToString("0.00")₼</strong> more for free shipping
                                </div>
                            }
                        </div>

                        <!-- Coupon discount -->
                        <div id="CartCouponDiscountContainer">
                            @if (!string.IsNullOrEmpty(Model.AppliedCouponCode) && Model.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pt-1 border-top border-light">
                                    <span class="small fw-semibold" style="color: #2e7d32;">
                                        <iconify-icon icon="mdi:tag" class="align-middle me-1"></iconify-icon>@Model.AppliedCouponCode:
                                    </span>
                                    <span class="small fw-bold" style="color: #2e7d32;">-@Model.DiscountAmount.ToString("0.00")₼</span>
                                </div>
                            }
                        </div>

                        <!-- Total inside details -->
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top">
                            <span class="text-dark fw-bold">Final Total:</span>
                            <strong class="text-dark fw-bold fs-6" id="CartDetailFinalPrice">@Model.FinalTotal.ToString("0.00")₼</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-grid gap-2">
                <a asp-controller="Basket" asp-action="Index" class="btn btn-outline-dark btn-sm py-2 fw-semibold">View Cart</a>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-sm py-2 fw-semibold">Checkout</a>
            </div>
        </div>
    </div>
</div>

<style>
    #offcanvasCart .offcanvas-body {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        -webkit-overflow-scrolling: touch;
    }
    #offcanvasCart .offcanvas-body::-webkit-scrollbar {
        width: 5px;
    }
    #offcanvasCart .offcanvas-body::-webkit-scrollbar-track {
        background: #f8f9fa;
    }
    #offcanvasCart .offcanvas-body::-webkit-scrollbar-thumb {
        background: #ced4da;
        border-radius: 4px;
    }
    #offcanvasCart .offcanvas-body::-webkit-scrollbar-thumb:hover {
        background: #adb5bd;
    }
</style>
