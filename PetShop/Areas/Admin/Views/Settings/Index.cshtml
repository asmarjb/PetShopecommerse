@{ ViewData["Title"] = "Settings"; }
<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                <div>
                    <h1 class="h3 mb-1">System Settings</h1>
                    <p class="text-muted mb-0">Configure global application preferences.</p>
                </div>
            </div>
            <div class="heading-actions">
                <button class="btn btn-primary btn-sm">Save Settings</button>
            </div>
        </div>

        <section class="row mt-4">
            <div class="col-12 col-xl-8">
                <div class="panel">
                    <div class="panel-header">
                        <h2 class="h5 mb-0">General Configuration</h2>
                    </div>
                    <div class="panel-body p-4">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Store Name</label>
                                <input type="text" class="form-control" value="Waggy Pet Shop">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Support Email</label>
                                <input type="email" class="form-control" value="support@waggy.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Currency</label>
                                <select class="form-select">
                                    <option value="USD" selected>USD ($)</option>
                                    <option value="EUR">EUR (€)</option>
                                    <option value="AZN">AZN (₼)</option>
                                </select>
                            </div>
                            <div class="mb-3 form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="maintenanceMode">
                                <label class="form-check-label" for="maintenanceMode">Maintenance Mode</label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>
